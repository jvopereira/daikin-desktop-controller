<UserControl x:Class="DaikinDesktopController.App.Panel.AirConditionerIllustration" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="280" Height="130" IsHitTestVisible="False" Focusable="False">
  <Canvas Width="280" Height="130">
    <!-- Soft shadow on the wall below the unit. -->
    <Ellipse Canvas.Left="40" Canvas.Top="82" Width="200" Height="14">
      <Ellipse.Fill>
        <RadialGradientBrush><GradientStop Color="#40000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Canvas x:Name="Unit">
      <Canvas.RenderTransform><TranslateTransform x:Name="Float"/></Canvas.RenderTransform>
      <!-- Body -->
      <Rectangle Canvas.Left="14" Canvas.Top="8" Width="252" Height="70" RadiusX="14" RadiusY="14" Stroke="#1F000000" StrokeThickness="1">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F3F4F6" Offset="0.55"/>
            <GradientStop Color="#D9DCE1" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- Top highlight and intake grille -->
      <Rectangle Canvas.Left="26" Canvas.Top="10" Width="228" Height="2" RadiusX="1" RadiusY="1" Fill="#CCFFFFFF"/>
      <Path Canvas.Left="34" Canvas.Top="16" Stroke="#1A000000" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M0 0h212 M0 4h212 M0 8h212"/>
      <!-- Side cap seam -->
      <Rectangle Canvas.Left="236" Canvas.Top="8" Width="1" Height="62" Fill="#14000000"/>
      <!-- Display window and status LED -->
      <Rectangle Canvas.Left="120" Canvas.Top="38" Width="40" Height="10" RadiusX="5" RadiusY="5" Fill="#14000000"/>
      <Ellipse x:Name="Led" Canvas.Left="136" Canvas.Top="40" Width="6" Height="6" Fill="#3FA9F5" Opacity="0">
        <Ellipse.Effect><DropShadowEffect x:Name="LedGlow" Color="#3FA9F5" ShadowDepth="0" BlurRadius="8" Opacity="1"/></Ellipse.Effect>
      </Ellipse>
      <!-- Discharge opening and louver -->
      <Rectangle Canvas.Left="30" Canvas.Top="62" Width="220" Height="12" RadiusX="6" RadiusY="6" Fill="#2B3036"/>
      <Path Canvas.Left="40" Canvas.Top="66" Stroke="#55FFFFFF" StrokeThickness="1" Data="M0 0h200 M0 3h200"/>
      <Rectangle x:Name="Flap" Canvas.Left="28" Canvas.Top="61" Width="224" Height="12" RadiusX="6" RadiusY="6" Stroke="#1F000000" StrokeThickness="1" RenderTransformOrigin="0.5,0">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F7F8FA" Offset="0"/><GradientStop Color="#CDD1D6" Offset="1"/></LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.RenderTransform>
          <TransformGroup><ScaleTransform x:Name="FlapScale"/><TranslateTransform x:Name="FlapOffset"/></TransformGroup>
        </Rectangle.RenderTransform>
      </Rectangle>
    </Canvas>
    <!-- Airflow wisps, animated while the unit is on. -->
    <Canvas x:Name="Airflow" Canvas.Left="50" Canvas.Top="84">
      <Path x:Name="Wisp1" Canvas.Left="0" Data="M0 4C20 -4 40 12 60 4" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
      <Path x:Name="Wisp2" Canvas.Left="70" Data="M0 4C20 -4 40 12 60 4" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
      <Path x:Name="Wisp3" Canvas.Left="140" Data="M0 4C20 -4 40 12 60 4" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
      <Path x:Name="Wisp4" Canvas.Left="35" Canvas.Top="10" Data="M0 4C25 -4 50 12 75 4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
      <Path x:Name="Wisp5" Canvas.Left="110" Canvas.Top="10" Data="M0 4C25 -4 50 12 75 4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
    </Canvas>
  </Canvas>
</UserControl>
