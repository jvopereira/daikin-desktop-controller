<Window x:Class="DaikinDesktopController.App.Panel.CompactControlPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DaikinDesktopController.App.Localization" xmlns:panel="clr-namespace:DaikinDesktopController.App.Panel" Title="{Binding [AppName], Source={x:Static loc:Localizer.Instance}}" Width="424" Height="620" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
<Window.Resources><ResourceDictionary Source="PanelResources.xaml"/></Window.Resources>
<!-- The outer margin leaves room for the card's drop shadow. -->
<Border x:Name="Card" Margin="12" CornerRadius="26" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" RenderTransformOrigin="0.5,1">
<Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.35"/></Border.Effect>
<Border.RenderTransform><TranslateTransform x:Name="CardOffset"/></Border.RenderTransform>
<Grid Margin="22,20,22,14" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

<!-- Header: room temperature and power -->
<Grid MinHeight="46">
<StackPanel x:Name="RoomView" Orientation="Horizontal" VerticalAlignment="Center">
<ContentControl Style="{StaticResource IconHost}" Tag="{StaticResource Icon.Thermometer}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
<TextBlock Text="{Binding [Room], Source={x:Static loc:Localizer.Instance}}" FontSize="17" Margin="8,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock x:Name="RoomValue" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
</StackPanel>
<TextBlock x:Name="HeaderTitle" Text="{Binding [AppName], Source={x:Static loc:Localizer.Instance}}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,56,0"/>
<ToggleButton x:Name="PowerToggle" Style="{StaticResource PowerButtonStyle}" Click="ChangePower" HorizontalAlignment="Right"/>
</Grid>

<!-- Air conditioner controls -->
<Grid x:Name="StatusView" Grid.Row="1" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<panel:AirConditionerIllustration x:Name="Illustration" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<Grid x:Name="ControlsArea" Grid.Row="1" Grid.RowSpan="4">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<TextBlock x:Name="TargetValue" FontSize="60" FontWeight="SemiBold" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><TranslateTransform x:Name="TargetOffset"/></TextBlock.RenderTransform></TextBlock>
<TextBlock Text="°C" FontSize="24" Margin="4,0,0,12" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
</StackPanel>
<Border Grid.Column="1" CornerRadius="18" Padding="14,10" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
<StackPanel Orientation="Horizontal">
<ContentControl Style="{StaticResource IconHost}" Width="22" Height="22" Tag="{StaticResource Icon.Leaf}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
<TextBlock Text="{Binding [EcoModeCard], Source={x:Static loc:Localizer.Instance}}" FontSize="15" FontWeight="SemiBold" Margin="10,0,12,0" VerticalAlignment="Center"/>
<ToggleButton x:Name="EconomyToggle" Style="{StaticResource SwitchToggleStyle}" Click="ChangeEconomyMode" AutomationProperties.Name="{Binding [EconomyMode], Source={x:Static loc:Localizer.Instance}}"/>
</StackPanel>
</Border>
</Grid>
<Grid Grid.Row="1" Margin="0,14,0,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Button x:Name="Decrease" Style="{StaticResource RoundIconButtonStyle}" Click="DecreaseTemperature" AutomationProperties.Name="{Binding [DecreaseTargetTemperature], Source={x:Static loc:Localizer.Instance}}"><ContentControl Style="{StaticResource IconHost}" Tag="{StaticResource Icon.Minus}"/></Button>
<Slider x:Name="TemperatureSlider" Grid.Column="1" Margin="10,0" Style="{StaticResource TemperatureSliderStyle}" IsSnapToTickEnabled="True" ToolTipService.ShowOnDisabled="True" ValueChanged="TemperatureChanged" Thumb.DragStarted="TemperatureDragStarted" Thumb.DragCompleted="TemperatureDragCompleted" AutomationProperties.Name="{Binding [TargetTemperature], Source={x:Static loc:Localizer.Instance}}"/>
<Button x:Name="Increase" Grid.Column="2" Style="{StaticResource RoundIconButtonStyle}" Click="IncreaseTemperature" AutomationProperties.Name="{Binding [IncreaseTargetTemperature], Source={x:Static loc:Localizer.Instance}}"><ContentControl Style="{StaticResource IconHost}" Tag="{StaticResource Icon.Plus}"/></Button>
</Grid>
<Grid x:Name="RangeLabels" Grid.Row="2" Margin="64,8,64,0">
<TextBlock x:Name="RangeMin" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
<TextBlock x:Name="RangeMax" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
</Grid>
<UniformGrid Grid.Row="3" Columns="4" Margin="-4,18,-4,0">
<ComboBox x:Name="OperatingModeSelector" Style="{StaticResource TileComboBoxStyle}" Tag="{StaticResource Icon.AutoMode}" panel:PanelState.Label="{Binding [ModeTile], Source={x:Static loc:Localizer.Instance}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ChangeOperatingMode" AutomationProperties.Name="{Binding [OperatingMode], Source={x:Static loc:Localizer.Instance}}"/>
<ComboBox x:Name="FanSpeedSelector" Style="{StaticResource TileComboBoxStyle}" Tag="{StaticResource Icon.Fan}" panel:PanelState.Label="{Binding [FanSpeedTile], Source={x:Static loc:Localizer.Instance}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ChangeFanSpeed" AutomationProperties.Name="{Binding [FanSpeed], Source={x:Static loc:Localizer.Instance}}"/>
<ToggleButton x:Name="TurboToggle" Style="{StaticResource TileToggleStyle}" Tag="{StaticResource Icon.Turbo}" panel:PanelState.Label="{Binding [TurboTile], Source={x:Static loc:Localizer.Instance}}" Click="ChangeTurboMode" AutomationProperties.Name="{Binding [TurboMode], Source={x:Static loc:Localizer.Instance}}"/>
<ToggleButton x:Name="ComfortToggle" Style="{StaticResource TileToggleStyle}" Tag="{StaticResource Icon.Wind}" panel:PanelState.Label="{Binding [AirflowTile], Source={x:Static loc:Localizer.Instance}}" Click="ChangeComfortMode" AutomationProperties.Name="{Binding [ComfortMode], Source={x:Static loc:Localizer.Instance}}"/>
</UniformGrid>
</Grid>
</Grid>

<!-- Setup, reading and unavailable states -->
<ScrollViewer x:Name="StateView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel VerticalAlignment="Center">
<panel:AirConditionerIllustration HorizontalAlignment="Center" Opacity="0.55" Margin="0,0,0,8"/>
<TextBlock x:Name="StateTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
<TextBlock x:Name="StateMessage" Margin="0,10,0,14" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
<ProgressBar x:Name="Progress" Style="{StaticResource ThinProgressBarStyle}" IsIndeterminate="True" Margin="40,0" Visibility="Collapsed"/>
<ListBox x:Name="Candidates" Style="{StaticResource CandidateListBoxStyle}" MaxHeight="150" SelectionChanged="Choose" Visibility="Collapsed"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Id}" TextWrapping="Wrap"/><TextBlock Text="{Binding Address}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<Button x:Name="ContextAction" Style="{StaticResource PanelPrimaryButtonStyle}" Click="OpenSection" Margin="0,12,0,0" Visibility="Collapsed"/>
<Button x:Name="Retry" Style="{StaticResource PanelSecondaryButtonStyle}" Content="{Binding [TryAgain], Source={x:Static loc:Localizer.Instance}}" Click="TryAgain" Margin="0,8,0,0" Visibility="Collapsed"/>
</StackPanel>
</ScrollViewer>

<!-- Footer: connection status and settings -->
<Grid Grid.Row="2" Margin="0,14,0,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel x:Name="FooterStatusView" Orientation="Horizontal" VerticalAlignment="Center">
<ContentControl x:Name="FooterIcon" Style="{StaticResource IconHost}" Width="18" Height="18" Tag="{StaticResource Icon.ShieldCheck}" RenderTransformOrigin="0.5,0.5"><ContentControl.RenderTransform><RotateTransform x:Name="FooterSpin"/></ContentControl.RenderTransform></ContentControl>
<TextBlock x:Name="FooterText" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
</StackPanel>
<Button Grid.Column="1" Style="{StaticResource FlatIconButtonStyle}" Click="OpenSettings" AutomationProperties.Name="{Binding [Settings], Source={x:Static loc:Localizer.Instance}}" ToolTip="{Binding [Settings], Source={x:Static loc:Localizer.Instance}}"><ContentControl Style="{StaticResource IconHost}" Tag="{StaticResource Icon.Sliders}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></Button>
</Grid>
</Grid>
</Border>
</Window>
