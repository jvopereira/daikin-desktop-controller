<Window x:Class="DaikinDesktopController.App.Panel.CompactControlPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DaikinDesktopController.App.Localization" Title="{Binding [AppName], Source={x:Static loc:Localizer.Instance}}" Width="360" Height="780" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="{DynamicResource ApplicationBackgroundBrush}">
<Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="{Binding [AppName], Source={x:Static loc:Localizer.Instance}}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center">
<TextBlock x:Name="StateTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock x:Name="StateMessage" Margin="0,12,0,12" FontSize="15" TextWrapping="Wrap"/>
<StackPanel x:Name="StatusView" Visibility="Collapsed" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
<TextBlock x:Name="Power" FontSize="24" FontWeight="SemiBold"/>
<ToggleButton x:Name="PowerToggle" Click="ChangePower" Margin="0,8,0,0"/>
<TextBlock x:Name="PowerPending" Text="{Binding [Pending], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock x:Name="PowerError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
<TextBlock Text="{Binding [OperatingMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,16,0,0"/>
<ComboBox x:Name="OperatingModeSelector" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ChangeOperatingMode" AutomationProperties.Name="{Binding [OperatingMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,8,0,0"/>
<TextBlock x:Name="OperatingModePending" Text="{Binding [Pending], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock x:Name="OperatingModeError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
<TextBlock Text="{Binding [FanSpeed], Source={x:Static loc:Localizer.Instance}}" Margin="0,16,0,0"/>
<ComboBox x:Name="FanSpeedSelector" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ChangeFanSpeed" AutomationProperties.Name="{Binding [FanSpeed], Source={x:Static loc:Localizer.Instance}}" Margin="0,8,0,0"/>
<TextBlock x:Name="FanSpeedPending" Text="{Binding [Pending], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock x:Name="FanSpeedError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
<TextBlock Text="{Binding [TurboMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,16,0,0"/>
<ToggleButton x:Name="TurboToggle" Click="ChangeTurboMode" AutomationProperties.Name="{Binding [TurboMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,8,0,0"/>
<TextBlock x:Name="TurboPending" Text="{Binding [Pending], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock x:Name="TurboError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
<TextBlock Text="{Binding [ComfortMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,16,0,0"/>
<ToggleButton x:Name="ComfortToggle" Click="ChangeComfortMode" AutomationProperties.Name="{Binding [ComfortMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,8,0,0"/>
<TextBlock x:Name="ComfortPending" Text="{Binding [Pending], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock x:Name="ComfortError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
<TextBlock Text="{Binding [EconomyMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,16,0,0"/>
<ToggleButton x:Name="EconomyToggle" Click="ChangeEconomyMode" AutomationProperties.Name="{Binding [EconomyMode], Source={x:Static loc:Localizer.Instance}}" Margin="0,8,0,0"/>
<TextBlock x:Name="EconomyPending" Text="{Binding [Pending], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock x:Name="EconomyError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
<TextBlock Text="{Binding [TargetTemperature], Source={x:Static loc:Localizer.Instance}}" Margin="0,16,0,0"/>
<StackPanel Orientation="Horizontal">
<Button x:Name="Decrease" Content="−" Click="DecreaseTemperature" AutomationProperties.Name="{Binding [DecreaseTargetTemperature], Source={x:Static loc:Localizer.Instance}}" Padding="12"/>
<TextBlock x:Name="TargetValue" FontSize="36" FontWeight="SemiBold" Margin="12,0"/>
<Button x:Name="Increase" Content="+" Click="IncreaseTemperature" AutomationProperties.Name="{Binding [IncreaseTargetTemperature], Source={x:Static loc:Localizer.Instance}}" Padding="12"/>
</StackPanel>
<Slider x:Name="TemperatureSlider" IsSnapToTickEnabled="True" ValueChanged="TemperatureChanged" Thumb.DragStarted="TemperatureDragStarted" Thumb.DragCompleted="TemperatureDragCompleted" AutomationProperties.Name="{Binding [TargetTemperature], Source={x:Static loc:Localizer.Instance}}" Margin="0,12"/>
<TextBlock x:Name="TemperaturePending" Text="{Binding [Pending], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock x:Name="TemperatureError" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
<StackPanel x:Name="RoomView" Margin="0,16,0,0">
<TextBlock Text="{Binding [RoomTemperature], Source={x:Static loc:Localizer.Instance}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
<TextBlock x:Name="RoomValue" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
</StackPanel>
</StackPanel>
<ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Visibility="Collapsed"/>
<ListBox x:Name="Candidates" MaxHeight="150" SelectionChanged="Choose" Visibility="Collapsed"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Id}" TextWrapping="Wrap"/><TextBlock Text="{Binding Address}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<Button x:Name="ContextAction" Click="OpenSection" Margin="0,12,0,0" Visibility="Collapsed"/>
<Button x:Name="Retry" Content="{Binding [TryAgain], Source={x:Static loc:Localizer.Instance}}" Click="TryAgain" Margin="0,8,0,0" Visibility="Collapsed"/>
</StackPanel>
</ScrollViewer>
<Button Grid.Row="2" Padding="12" Click="OpenSettings" AutomationProperties.Name="{Binding [Settings], Source={x:Static loc:Localizer.Instance}}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Margin="0,0,8,0"/><TextBlock Text="{Binding [Settings], Source={x:Static loc:Localizer.Instance}}"/></StackPanel></Button>
</Grid></Border></Window>
