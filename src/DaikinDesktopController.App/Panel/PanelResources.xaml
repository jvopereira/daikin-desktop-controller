<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:panel="clr-namespace:DaikinDesktopController.App.Panel">

  <!-- Line icons on a 24×24 grid, drawn with round strokes. -->
  <StreamGeometry x:Key="Icon.Thermometer">M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Power">M12 2v10 M18.4 6.6a9 9 0 1 1-12.77 0.04</StreamGeometry>
  <StreamGeometry x:Key="Icon.Leaf">M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8c0 5.5-4.78 10-10 10Z M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Minus">M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12 5v14 M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Snowflake">M2 12h20 M12 2v20 M20 16l-4-4l4-4 M4 8l4 4l-4 4 M16 4l-4 4l-4-4 M8 20l4-4l4 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.AutoMode">M4.5 19L12 4l7.5 15 M7.5 13h9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sun">M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8Z M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M6.34 17.66l-1.41 1.41 M19.07 4.93l-1.41 1.41</StreamGeometry>
  <StreamGeometry x:Key="Icon.Droplet">M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5S12.5 5.5 12 3c-0.5 2.5-2 4.9-4 6.5S5 13 5 15a7 7 0 0 0 7 7Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Fan">M10.83 16.38a6.08 6.08 0 0 1-8.62-7l5.41 1.45a6.08 6.08 0 0 1 7-8.62l-1.45 5.41a6.08 6.08 0 0 1 8.62 7l-5.41-1.45a6.08 6.08 0 0 1-7 8.62l1.45-5.41Z M12 12v0.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Turbo">M13 2L3 14h9l-1 8l10-12h-9l1-8Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Wind">M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2 M9.6 4.6A2 2 0 1 1 11 8H2 M12.6 19.4A2 2 0 1 0 14 16H2</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronDown">M6 9l6 6l6-6</StreamGeometry>
  <StreamGeometry x:Key="Icon.ShieldCheck">M12 22s8-4 8-10V5l-8-3l-8 3v7c0 6 8 10 8 10Z M9 12l2 2l4-4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Alert">M12 9v4 M12 17h0.01 M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sync">M21 12a9 9 0 1 1-3-6.7L21 8 M21 3v5h-5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sliders">M4 6h10 M18 6h2 M16 4v4 M4 12h4 M12 12h8 M10 10v4 M4 18h12 M20 18h0.01 M18 16v4</StreamGeometry>

  <LinearGradientBrush x:Key="SliderFillWarm" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#33B9A68A" Offset="0"/>
    <GradientStop Color="#B3B9A68A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SliderFillCool" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#333FA9F5" Offset="0"/>
    <GradientStop Color="#B33FA9F5" Offset="1"/>
  </LinearGradientBrush>
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

  <!-- Hosts an icon geometry passed through Tag; Foreground is the stroke colour. -->
  <Style x:Key="IconHost" TargetType="ContentControl">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FocusVisualRounded">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" Margin="-2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PowerButtonStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="46"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRounded}"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Ellipse Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1"/>
            <Ellipse x:Name="Ring" Stroke="#3FA9F5" StrokeThickness="2" Opacity="0">
              <Ellipse.Effect><DropShadowEffect Color="#3FA9F5" ShadowDepth="0" BlurRadius="18" Opacity="0.9"/></Ellipse.Effect>
            </Ellipse>
            <ContentControl x:Name="Glyph" Style="{StaticResource IconHost}" Tag="{StaticResource Icon.Power}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="Foreground" Value="#3FA9F5"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="panel:PanelState.IsPending" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="PowerPulse"><Storyboard><DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="PowerPulse"/></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RoundIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRounded}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Ellipse Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1"/>
            <Ellipse x:Name="Hover" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" CornerRadius="10" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Back" Property="Opacity" Value="0.7"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderTransparentRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderFillRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border CornerRadius="20,0,0,20" Margin="2,2,-12,2" Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Knob" CornerRadius="10" Background="#F4F4F2" BorderBrush="#26000000" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.35"/></Border.Effect>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Setter.Value></Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TemperatureSliderStyle" TargetType="Slider">
    <Setter Property="Tag" Value="{StaticResource SliderFillWarm}"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRounded}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="44">
            <Border CornerRadius="22" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
            <Track x:Name="PART_Track" Margin="10,0">
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderFillRepeat}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderTransparentRepeat}"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource SliderThumbStyle}"/></Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border CornerRadius="13" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1"/>
            <Border x:Name="OnTrack" CornerRadius="13" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0"/>
            <Ellipse x:Name="Knob" Width="18" Height="18" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource TextFillColorSecondaryBrush}">
              <Ellipse.RenderTransform><TranslateTransform x:Name="KnobOffset"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobOffset" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                  <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                  <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="panel:PanelState.IsPending" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="SwitchPulse"><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="SwitchPulse"/></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Shared tile look for the four controls under the slider. -->
  <Style x:Key="TileToggleStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="104"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRounded}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Tile" CornerRadius="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Grid>
              <Border x:Name="Hover" CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0"/>
              <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ContentControl x:Name="Glyph" Style="{StaticResource IconHost}" Width="24" Height="24" Tag="{TemplateBinding Tag}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Ellipse x:Name="Dot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0" Fill="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.6"/>
                <TextBlock Grid.Row="1" Text="{Binding (panel:PanelState.Label), RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Text="{Binding (panel:PanelState.Value), RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Fill" Value="#3FA9F5"/>
              <Setter TargetName="Dot" Property="Opacity" Value="1"/>
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="panel:PanelState.IsPending" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="TilePulse"><Storyboard><DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="TilePulse"/></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TileComboBoxItemStyle" TargetType="ComboBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Back" CornerRadius="8" Padding="10,7" Margin="0,1" Background="Transparent">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <Ellipse x:Name="Check" Grid.Column="1" Width="6" Height="6" Margin="10,0,0,0" Fill="#3FA9F5" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DropDownToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TileComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Height" Value="104"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRounded}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource TileComboBoxItemStyle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Tile" CornerRadius="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid>
                <Border x:Name="Hover" CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0"/>
                <Grid Margin="12">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <ContentControl Style="{StaticResource IconHost}" Width="24" Height="24" Tag="{TemplateBinding Tag}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                  <ContentControl x:Name="Chevron" Style="{StaticResource IconHost}" Width="16" Height="16" Tag="{StaticResource Icon.ChevronDown}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform><RotateTransform x:Name="ChevronRotation"/></ContentControl.RenderTransform>
                  </ContentControl>
                  <TextBlock Grid.Row="1" Text="{Binding (panel:PanelState.Label), RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="2" Text="{Binding (panel:PanelState.Value), RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </Grid>
              </Grid>
            </Border>
            <ToggleButton Style="{StaticResource DropDownToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border Margin="8" Padding="4" MinWidth="160" CornerRadius="12" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" TextElement.FontSize="14">
                <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="14" Opacity="0.35"/></Border.Effect>
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="panel:PanelState.IsPending" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="ComboPulse"><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="ComboPulse"/></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelPrimaryButtonStyle" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Back" Property="Opacity" Value="0.75"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PanelSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPrimaryButtonStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
  </Style>
  <Style x:Key="ThinProgressBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="3"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>
  <Style x:Key="CandidateListBoxStyle" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
</ResourceDictionary>
