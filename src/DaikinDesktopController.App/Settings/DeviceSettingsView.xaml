<UserControl x:Class="DaikinDesktopController.App.Settings.DeviceSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DaikinDesktopController.App.Localization">
<StackPanel>
<TextBlock Text="{Binding [DeviceIpAddress], Source={x:Static loc:Localizer.Instance}}"/>
<TextBox x:Name="Address" Margin="0,8,0,12" LostFocus="CommitAddress" KeyDown="AddressKeyDown" AutomationProperties.Name="{Binding [DeviceIpAddress], Source={x:Static loc:Localizer.Instance}}"/>
<TextBlock Text="{Binding [DeviceIpHelp], Source={x:Static loc:Localizer.Instance}}" TextWrapping="Wrap"/>
<TextBlock x:Name="Feedback" Margin="0,12,0,24" TextWrapping="Wrap"/>
<TextBlock Text="{Binding [StatusRefreshInterval], Source={x:Static loc:Localizer.Instance}}" TextWrapping="Wrap"/>
<ComboBox x:Name="RefreshInterval" Margin="0,8,0,0" SelectionChanged="IntervalChanged" AutomationProperties.Name="{Binding [StatusRefreshInterval], Source={x:Static loc:Localizer.Instance}}"/>
</StackPanel></UserControl>