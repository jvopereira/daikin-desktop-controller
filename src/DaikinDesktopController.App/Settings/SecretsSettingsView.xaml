<UserControl x:Class="DaikinDesktopController.App.Settings.SecretsSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DaikinDesktopController.App.Localization">
<StackPanel>
<TextBlock Text="{Binding [DeviceSecretKey], Source={x:Static loc:Localizer.Instance}}"/>
<PasswordBox x:Name="HiddenKey" Margin="0,8,0,8" AutomationProperties.Name="{Binding [DeviceSecretKey], Source={x:Static loc:Localizer.Instance}}"/>
<TextBox x:Name="VisibleKey" Visibility="Collapsed" Margin="0,8,0,8" AutomationProperties.Name="{Binding [DeviceSecretKey], Source={x:Static loc:Localizer.Instance}}"/>
<CheckBox Content="{Binding [RevealKey], Source={x:Static loc:Localizer.Instance}}" Checked="Reveal" Unchecked="HideKey"/>
<TextBlock x:Name="SavedHint" Margin="0,12,0,0" Text="{Binding [KeyAlreadySaved], Source={x:Static loc:Localizer.Instance}}" TextWrapping="Wrap"/>
<Button Content="{Binding [Save], Source={x:Static loc:Localizer.Instance}}" Click="SaveKey" Margin="0,16,0,12" HorizontalAlignment="Left" Padding="16,8"/>
<TextBlock x:Name="Feedback" TextWrapping="Wrap"/>
</StackPanel></UserControl>