<Window x:Class="DaikinDesktopController.App.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DaikinDesktopController.App.Localization" Title="{Binding [Settings], Source={x:Static loc:Localizer.Instance}}" Width="720" Height="500" MinWidth="560" MinHeight="360" WindowStartupLocation="CenterScreen">
<Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListBox x:Name="Navigation" SelectionChanged="SectionChanged"><ListBoxItem Tag="Secrets" Content="{Binding [Secrets], Source={x:Static loc:Localizer.Instance}}"/><ListBoxItem Tag="Device" Content="{Binding [Device], Source={x:Static loc:Localizer.Instance}}"/><ListBoxItem Tag="General" Content="{Binding [General], Source={x:Static loc:Localizer.Instance}}"/></ListBox>
<ContentControl Grid.Column="1" Margin="24,0,0,0"><TextBlock x:Name="Placeholder" FontSize="16" TextWrapping="Wrap"/></ContentControl></Grid></Window>
